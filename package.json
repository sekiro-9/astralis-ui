{
  "name": "astralis-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:ui": "pnpm --filter astralis-ui dev",
    "dev:docs": "pnpm --filter astralis-docs dev",
    "preview:docs": "pnpm --filter astralis-docs start",
    "build": "pnpm -r build",
