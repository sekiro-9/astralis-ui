{
  "name": "astralis-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run gen:thumbs && pnpm run gen:registry && next dev",
    "build": "pnpm run gen:thumbs && pnpm run gen:registry && next build && pnpm run gen:search",
    "gen:thumbs": "node scripts/gen-block-thumbnails.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:registry": "node scripts/gen-block-registry.mjs",
    "gen:search": "node scripts/build-search-index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "astralis-blocks": "workspace:*",
    "astralis-cli": "workspace:*",
    "astralis-ui": "workspace:*",
    "better-auth": "^1.7.6",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.554.0",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
