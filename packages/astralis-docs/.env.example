# The issue platform (/issues). The rest of the site needs none of these:
# without DATABASE_URL the docs build and run, and only /issues says it is
# not configured. Copy this file to .env.local and fill it in.

# Postgres connection string. Locally, `docker compose up -d` in this folder
# starts one at:
#   postgres://issues:issues@127.0.0.1:5433/astralis_issues
# then `pnpm db:migrate` creates the tables.
DATABASE_URL=

# Signs session cookies and keys the hashed addresses used to rate-limit
# drafts. Generate one with:  openssl rand -base64 32
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Where the site is reached: http://localhost:3000 locally, the deployment's
# address in production.
BETTER_AUTH_URL=

# GitHub sign-in, the only way to sign in. From a GitHub OAuth app (or the
# GitHub App's client credentials) whose callback URL is
#   <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
