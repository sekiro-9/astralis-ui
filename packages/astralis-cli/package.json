{
  "name": "astralis-cli",
  "version": "0.5.0",
  "description": "Setup and tooling CLI for Astralis UI — scaffold or wire up a project, add blocks, generate a static brand theme, validate code against the design system, connect the MCP server.",
  "type": "module",
  "license": "MIT",
  "author": "Paul Andrew",
  "homepage": "https://astralis-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sekiro-9/astralis-ui.git",
    "directory": "packages/astralis-cli"
  },
  "bugs": {
    "url": "https://github.com/sekiro-9/astralis-ui/issues"
  },
  "keywords": [
    "astralis-ui",
    "cli",
    "react",
    "components",
    "theming",
    "setup",
    "mcp"
  ],
  "bin": {
    "astralis": "src/index.mjs"
  },
  "exports": {
    "./cli": "./src/index.mjs",
    "./validate": {
      "types": "./src/lib/validate.d.mts",
      "default": "./src/lib/validate.mjs"
    },
    "./validate-core": {
      "types": "./src/lib/validate-core.d.mts",
      "default": "./src/lib/validate-core.mjs"
    },
    "./snapshot": {
      "types": "./src/lib/snapshot.d.mts",
      "default": "./src/lib/snapshot.mjs"
    }
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "reference": "node scripts/reference.mjs"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "astralis-ui": "workspace:^"
  }
}
